@model LoginViewModel
@inject ILocalizer Loc
@inject IConfiguration Config
@{
    ViewData["Title"] = Loc["account_login_title"];
}

<div class="login-wrap">
    <div class="login-left">
        <h2 style="color:#fff;margin-top:0">@Loc["account_login_title"]</h2>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="err"></div>

            <div class="login-panel">
                <label class="login-label">@Loc["account_login_label"]</label>
                <input asp-for="Login" class="input" autocomplete="username" />
                <label class="login-label">@Loc["account_password_label"]</label>
                <input asp-for="Password" type="password" class="input" autocomplete="current-password" />
                <label class="check" style="margin-top:8px"><input asp-for="RememberMe" /> @Loc["account_remember"]</label>

                <div style="display:flex;gap:12px;margin-top:16px;align-items:center">
                    <button type="submit" class="btn-sign" style="flex:0 0 220px">@Loc["account_login_btn"]</button>
                    <a asp-action="ForgotPassword" class="login-help" style="flex:1;text-align:center;cursor:pointer;display:block;padding:10px;text-decoration:none;">@Loc["login_help_title"]</a>
                </div>

                <p class="muted small center" style="margin-top:12px">@Loc["account_no_account"] <a class="green" asp-action="Register">@Loc["account_create_new"]</a></p>
                <p class="muted small center">@Loc["account_demo"]: demo@vstore.local / Demo123!</p>
            </div>
        </form>
    </div>

    <div class="login-right">
        <div class="qr-card">
            <div class="qr-title">@Loc["account_qr_login"]</div>
            <div class="qr-wrap" style="margin-bottom:10px;">
                @{ var scanUrl = Url.Action("QrScan","Account", new { token = Model.QRToken }, Context.Request.Scheme) ?? ""; var qrSrc = "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=" + System.Uri.EscapeDataString(scanUrl); }
                <img id="qrimg" src="@qrSrc" alt="QR code" />
            </div>
            <div style="font-size:12px;color:#9aa4ad">@Loc["account_qr_instructions"]</div>
        </div>
    </div>

<script>
    (function(){
        var token = '@Model.QRToken';
        if(!token) return;
        var pollUrl = '@Url.Action("QrPoll","Account")';
        var autoUrl = '@Url.Action("QrAutoLogin","Account")';
        var poll = setInterval(async function(){
            try{
                const resp = await fetch(pollUrl + '?token=' + encodeURIComponent(token));
                const js = await resp.json();
                if (js && js.authenticated) {
                    clearInterval(poll);
                    document.getElementById('qrstatus').textContent = '@Loc["account_qr_confirmed"]';
                    const r2 = await fetch(autoUrl, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'token=' + encodeURIComponent(token) });
                    const j2 = await r2.json();
                    if (j2 && j2.ok) {
                        window.location = j2.redirect || '/';
                    } else {
                        document.getElementById('qrstatus').textContent = '@Loc["account_qr_failed"]';
                    }
                }
            } catch(e){ console.warn(e); }
        },2000);
    })();
</script>
