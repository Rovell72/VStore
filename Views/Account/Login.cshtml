<script>
    (function(){
        var token = '@Model.QRToken';
        if(!token) return;
        var pollUrl = '@Url.Action("QrPoll","Account")';
        var autoUrl = '@Url.Action("QrAutoLogin","Account")';
        var poll = setInterval(async function(){
            try{
                const resp = await fetch(pollUrl + '?token=' + encodeURIComponent(token));
                const js = await resp.json();
                if (js && js.authenticated) {
                    clearInterval(poll);
                    document.getElementById('qrstatus').textContent = 'Подтверждено, выполняем вход...';
                    const r2 = await fetch(autoUrl, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'token=' + encodeURIComponent(token) });
                    const j2 = await r2.json();
                    if (j2 && j2.ok) {
                        window.location = j2.redirect || '/';
                    } else {
                        document.getElementById('qrstatus').textContent = 'Автоматический вход не удался';
                    }
                }
            } catch(e){ console.warn(e); }
        },2000);
    })();
</script>
