@inject ILocalizer Loc
@{
    ViewData["Title"] = Loc["account_created_title"];
}
<div class="auth panel center">
    <h2>@Loc["account_created_title"]</h2>
    <p class="muted">@Loc["account_created_text"]</p>
    <a class="btn btn-primary wide" asp-action="Login">@Loc["account_login_btn"]</a>
</div>
