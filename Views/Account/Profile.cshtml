@model ProfileViewModel
@inject ILocalizer Loc
@inject IGameLocalizer GameLoc
@{
    ViewData["Title"] = Loc["profile"];
}
<div class="profile-head panel">
    <div class="avatar big">@Model.User.Nickname[0]</div>
    <div>
        <h1>@Model.User.Nickname</h1>
        <div class="muted">@Loc["profile_level_value"] @Model.Level</div>
    </div>
    <div class="stats">
        <div><b>@Model.Library.Count</b><span class="muted small">@Loc["profile_games"]</span></div>
        <div><b>@Model.Unlocked.Count</b><span class="muted small">@Loc["profile_achievements"]</span></div>
    </div>
</div>

<h2>@Loc["profile_achievements"] <a class="small green" asp-action="Achievements">@Loc["profile_show_all"]</a></h2>
<div class="ach-strip">
    @foreach (var a in Model.Unlocked.Take(8))
    {
        <div class="ach-card">
            <div class="ach-icon">@a.Icon</div>
            <b>@a.Title</b>
            <div class="muted small">@GameLoc.Title(a.Game)</div>
        </div>
    }
    @if (Model.Unlocked.Count == 0) { <p class="muted">@Loc["profile_empty_achievements"]</p> }
</div>

<h2>@Loc["profile_collection"]</h2>
<div class="grid grid-2">
    @foreach (var l in Model.Library)
    {
        <a class="lib" asp-controller="Home" asp-action="Game" asp-route-id="@l.GameId" style="background:linear-gradient(135deg,@(l.Game.ColorFrom),@(l.Game.ColorTo))">
            <b>@GameLoc.Title(l.Game)</b>
            <span class="small">@Loc["account_played"]: @l.HoursPlayed.ToString("0.0") h</span>
        </a>
    }
    @if (Model.Library.Count == 0) { <p class="muted">@Loc["profile_empty"] <a class="green" asp-controller="Home" asp-action="Index">@Loc["nav_store"]</a></p> }
</div>
