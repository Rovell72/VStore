@model LoginViewModel
@inject ILocalizer Loc
@{
    ViewData["Title"] = Loc["account_qr_confirm_title"];
}
<div class="auth panel" style="max-width:420px;margin:40px auto">
    <h2>@Loc["account_qr_confirm_title"]</h2>
    <form asp-action="QrScan" method="post">
        <input type="hidden" asp-for="QRToken" />
        <div asp-validation-summary="All" class="err"></div>
        <label>@Loc["account_login_label"]</label>
        <input asp-for="Login" class="input" autocomplete="username" />
        <label>@Loc["account_password_label"]</label>
        <input asp-for="Password" type="password" class="input" autocomplete="current-password" />
        <button class="btn btn-primary wide" style="margin-top:12px">@Loc["account_qr_confirm_btn"]</button>
    </form>
    <p class="muted small center">@Loc["account_qr_confirm_text"]</p>
</div>
