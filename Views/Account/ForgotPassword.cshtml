@inject ILocalizer Loc
@{
    ViewData["Title"] = Loc["forgot_title"];
}
<div class="auth panel">
    <h2>@Loc["forgot_title"]</h2>
    <p class="muted">@Loc["forgot_text"]</p>
    <div asp-validation-summary="All" class="err"></div>
    <form asp-action="ForgotPassword" method="post">
        <label>@Loc["account_email_label"]</label>
        <input name="email" type="email" class="input" required />
        <button class="btn btn-primary wide">@Loc["forgot_send"]</button>
    </form>
    <p class="muted small center"><a class="green" asp-action="Login">@Loc["forgot_back"]</a></p>
</div>
