@inject ILocalizer Loc
@{
    ViewData["Title"] = Loc["reset_title"];
    bool valid = ViewBag.Valid;
}
<div class="auth panel">
    <h2>@Loc["reset_title"]</h2>
    @if (!valid)
    {
        <p class="err">@Loc["reset_invalid"]</p>
        <a class="btn btn-ghost wide" asp-action="ForgotPassword">@Loc["forgot_title"]</a>
    }
    else
    {
        <div asp-validation-summary="All" class="err"></div>
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <label>@Loc["reset_new_password"]</label>
            <input name="password" type="password" class="input" minlength="6" required />
            <button class="btn btn-primary wide">@Loc["reset_save"]</button>
        </form>
    }
</div>
