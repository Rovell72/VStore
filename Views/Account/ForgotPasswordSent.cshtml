@inject ILocalizer Loc
@{
    ViewData["Title"] = Loc["forgot_sent_title"];
}
<div class="auth panel center">
    <h2>@Loc["forgot_sent_title"]</h2>
    <p class="muted">@Loc["forgot_sent_text"]</p>
    <div class="reset-link">@ViewBag.ResetLink</div>
    <a class="btn btn-primary wide" href="@ViewBag.ResetLink">@Loc["reset_title"]</a>
</div>
