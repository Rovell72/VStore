@model Game
@inject IGameLocalizer GameLoc
<a class="card" asp-controller="Home" asp-action="Game" asp-route-id="@Model.Id">
    <div class="cover" style="background:linear-gradient(135deg,@(Model.ColorFrom),@(Model.ColorTo))"><span>@GameLoc.Title(Model)</span></div>
    <div class="card-body">
        <div class="card-title">@GameLoc.Title(Model)</div>
        <div class="muted small">@GameLoc.Genre(Model)</div>
        <div class="price-row">
            @if (Model.DiscountPercent > 0)
            {
                <span class="badge">-@(Model.DiscountPercent)%</span>
                <s class="muted small">@Model.Price.Money()</s>
            }
            <b>@Model.FinalPrice.Money()</b>
        </div>
    </div>
</a>
