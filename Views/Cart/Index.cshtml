@model List<CartItem>
@{
    ViewData["Title"] = "Корзина";
    var total = Model.Sum(i => i.Game.FinalPrice);
}
<div class="narrow">
    <h1>Моя корзина</h1>
    @if (Model.Count == 0)
    {
        <p class="muted">Корзина пуста. <a class="green" asp-controller="Home" asp-action="Index">Перейти в магазин</a></p>
    }
    else
    {
        <div class="list">
            @foreach (var i in Model)
            {
                <div class="row">
                    <div class="thumb" style="background:linear-gradient(135deg,@(i.Game.ColorFrom),@(i.Game.ColorTo))"></div>
                    <div class="grow">
                        <a asp-controller="Home" asp-action="Game" asp-route-id="@i.GameId"><b>@i.Game.Title</b></a>
                        <div class="muted small">@i.Game.Genre</div>
                        <div class="btn-row">
                            <form asp-action="Remove" method="post"><input type="hidden" name="id" value="@i.Id" /><button class="link">Удалить</button></form>
                            <form asp-action="MoveToWishlist" method="post"><input type="hidden" name="id" value="@i.Id" /><button class="link">В желаемое</button></form>
                        </div>
                    </div>
                    <div>
                        @if (i.Game.DiscountPercent > 0){<span class="badge">-@(i.Game.DiscountPercent)%</span>}
                        <b>@i.Game.FinalPrice.Money()</b>
                    </div>
                </div>
            }
        </div>
        <div class="total panel">
            <span>Итого</span><b>@total.Money()</b>
            <a class="btn btn-primary" asp-action="Checkout">Оформить заказ</a>
        </div>
    }
</div>
