@inject ILocalizer Loc
@{
    ViewData["Title"] = Loc["success_title"];
}
<div class="auth panel center">
    <div class="logo-v big">V</div>
    <h2>@Loc["success_purchase_title"]</h2>
    <p class="muted">@Loc["success_purchase_text"]</p>
    <a class="btn btn-primary wide" asp-controller="Account" asp-action="Profile">@Loc["success_go_profile"]</a>
</div>
