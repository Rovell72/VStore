@model List<Game>
@inject ILocalizer Loc
@inject IGameLocalizer GameLoc
@{
    ViewData["Title"] = Loc["admin_games"];
}
<div class="btn-row-top">
    <h1>@Loc["admin_games"]</h1>
    <a class="btn btn-primary" asp-action="CreateGame">@Loc["admin_add_game"]</a>
</div>
<div class="list">
    @foreach (var g in Model)
    {
        <div class="row">
            <div class="thumb" style="background:linear-gradient(135deg,@(g.ColorFrom),@(g.ColorTo))"></div>
            <div class="grow"><b>@GameLoc.Title(g)</b><div class="muted small">@GameLoc.Genre(g) · @g.FinalPrice.Money()</div></div>
            <div class="btn-row">
                <a class="btn btn-ghost btn-sm" asp-action="EditGame" asp-route-id="@g.Id">@Loc["admin_edit"]</a>
                <form asp-action="DeleteGame" method="post" onsubmit="return confirm('@Loc["admin_delete_game_confirm"]');">
                    <input type="hidden" name="id" value="@g.Id" />
                    <button class="btn btn-ghost btn-sm">@Loc["admin_delete"]</button>
                </form>
            </div>
        </div>
    }
</div>
