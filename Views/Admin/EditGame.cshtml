@model AdminGameViewModel
@inject ILocalizer Loc
@{
    ViewData["Title"] = Model.Id == 0 ? Loc["admin_add_game"] : Loc["admin_edit"];
}
<div class="narrow">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="SaveGame" method="post" class="panel">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="err"></div>
        <label>Название</label>
        <input asp-for="Title" class="input" />
        <label>Описание</label>
        <textarea asp-for="Description" rows="3" class="input"></textarea>
        <div class="two">
            <div><label>Разработчик</label><input asp-for="Developer" class="input" /></div>
            <div><label>Издатель</label><input asp-for="Publisher" class="input" /></div>
        </div>
        <div class="two">
            <div><label>Жанр</label><input asp-for="Genre" class="input" /></div>
            <div><label>Дата выхода</label><input asp-for="ReleaseDate" type="date" class="input" /></div>
        </div>
        <div class="two">
            <div><label>Цена, $</label><input asp-for="Price" type="number" step="0.01" class="input" /></div>
            <div><label>Скидка, %</label><input asp-for="DiscountPercent" type="number" class="input" /></div>
        </div>
        <div class="two">
            <div><label>Возрастной рейтинг</label><input asp-for="AgeRating" type="number" class="input" /></div>
            <div class="check" style="align-self:flex-end"><label><input asp-for="IsFeatured" /> Показывать в рекомендуемых</label></div>
        </div>
        <div class="two">
            <div><label>Цвет обложки (от)</label><input asp-for="ColorFrom" type="color" class="input" /></div>
            <div><label>Цвет обложки (до)</label><input asp-for="ColorTo" type="color" class="input" /></div>
        </div>
        <label>Минимальные требования (через |)</label>
        <textarea asp-for="MinRequirements" rows="2" class="input"></textarea>
        <label>Рекомендуемые требования (через |)</label>
        <textarea asp-for="RecRequirements" rows="2" class="input"></textarea>
        <button class="btn btn-primary wide">@Loc["admin_save"]</button>
    </form>
</div>
