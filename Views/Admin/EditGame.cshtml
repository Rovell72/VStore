@model AdminGameViewModel
@inject ILocalizer Loc
@{
    ViewData["Title"] = Model.Id == 0 ? Loc["admin_add_game"] : Loc["admin_edit"];
}
<div class="narrow">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="SaveGame" method="post" class="panel">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="err"></div>
        <label>@Loc["admin_game_title"]</label>
        <input asp-for="Title" class="input" />
        <label>@Loc["admin_description"]</label>
        <textarea asp-for="Description" rows="3" class="input"></textarea>
        <div class="two">
            <div><label>@Loc["admin_developer"]</label><input asp-for="Developer" class="input" /></div>
            <div><label>@Loc["admin_publisher"]</label><input asp-for="Publisher" class="input" /></div>
        </div>
        <div class="two">
            <div><label>@Loc["admin_genre"]</label><input asp-for="Genre" class="input" /></div>
            <div><label>@Loc["admin_release_date"]</label><input asp-for="ReleaseDate" type="date" class="input" /></div>
        </div>
        <div class="two">
            <div><label>@Loc["admin_price"]</label><input asp-for="Price" type="number" step="0.01" class="input" /></div>
            <div><label>@Loc["admin_discount"]</label><input asp-for="DiscountPercent" type="number" class="input" /></div>
        </div>
        <div class="two">
            <div><label>@Loc["admin_age_rating"]</label><input asp-for="AgeRating" type="number" class="input" /></div>
            <div class="check" style="align-self:flex-end"><label><input asp-for="IsFeatured" /> @Loc["admin_featured"]</label></div>
        </div>
        <div class="two">
            <div><label>@Loc["admin_cover_color_from"]</label><input asp-for="ColorFrom" type="color" class="input" /></div>
            <div><label>@Loc["admin_cover_color_to"]</label><input asp-for="ColorTo" type="color" class="input" /></div>
        </div>
        <label>@Loc["admin_min_requirements"]</label>
        <textarea asp-for="MinRequirements" rows="2" class="input"></textarea>
        <label>@Loc["admin_rec_requirements"]</label>
        <textarea asp-for="RecRequirements" rows="2" class="input"></textarea>
        <button class="btn btn-primary wide">@Loc["admin_save"]</button>
    </form>
</div>
