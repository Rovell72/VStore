@model List<LibraryItem>
@inject ILocalizer Loc
@{
    ViewData["Title"] = Loc["library_title"];
    string? q = ViewBag.Query;
}
<div class="narrow">
    <h1>@Loc["library_title"]</h1>
    <form method="get" class="search-bar">
        <input class="input" type="text" name="q" placeholder="@Loc["library_search"]" value="@q" />
        <button class="btn btn-ghost">@Loc["search_placeholder"]</button>
    </form>
    @if (Model.Count == 0)
    {
        <p class="muted">@Loc["library_empty"]</p>
    }
    else
    {
        <div class="grid grid-2">
            @foreach (var l in Model)
            {
                <a class="lib" asp-controller="Home" asp-action="Game" asp-route-id="@l.GameId" style="background:linear-gradient(135deg,@(l.Game.ColorFrom),@(l.Game.ColorTo))">
                    <b>@l.Game.Title</b>
                    <span class="small">@Loc["library_hours"]: @l.HoursPlayed.ToString("0.0") ч. · @Loc["library_play"]</span>
                </a>
            }
        </div>
    }
</div>
