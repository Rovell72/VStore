@model SupportPageViewModel
@inject ILocalizer Loc
@inject IFaqLocalizer FaqLoc
@inject IConfiguration Configuration
@{
    ViewData["Title"] = Loc["support_title"];
    var supportEmail = Configuration["Email:FromEmail"];
}
<div class="narrow">
    <h1>@Loc["support_title"]</h1>
    <input id="faq-search" class="input" type="text" placeholder="@Loc["support_search"]" />
    <div class="faq">
        @foreach (var f in Model.Faq)
        {
            <div class="faq-item">
                <button type="button" class="faq-q"><span>@FaqLoc.Question(f)</span><span class="arrow">›</span></button>
                <div class="faq-a">@FaqLoc.Answer(f)</div>
            </div>
        }
    </div>
    <div class="center">
        <h2>@Loc["support_questions_left"]</h2>
        <a class="btn btn-ghost" href="mailto:@supportEmail">@Loc["support_contact_email"]</a>
    </div>

    <h2>@Loc["support_form_title"]</h2>
    @if (Model.TicketSent)
    {
        <p class="panel green">@Loc["support_sent"]</p>
    }
    else
    {
        <form asp-controller="Home" asp-action="SubmitTicket" method="post" class="panel">
            <div asp-validation-summary="All" class="err"></div>
            <label>@Loc["support_name"]</label>
            <input asp-for="Ticket.Name" class="input" />
            <label>@Loc["support_email"]</label>
            <input asp-for="Ticket.Email" class="input" />
            <label>@Loc["support_subject"]</label>
            <input asp-for="Ticket.Subject" class="input" />
            <label>@Loc["support_message"]</label>
            <textarea asp-for="Ticket.Message" rows="4" class="input"></textarea>
            <button class="btn btn-primary wide">@Loc["support_send"]</button>
        </form>
    }
</div>
